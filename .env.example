# Register PUBLIC_ORIGIN/auth/callback on the Fluxer application.
PUBLIC_ORIGIN=https://cinema.example.com
FLUXER_ORIGIN=https://chat.example.com
FLUXER_GUILD_ID=1234567890123456789
# Comma-separated voice channel IDs; empty permits all voice channels in the community.
FLUXER_CHANNEL_IDS=
FLUXER_BOT_TOKEN=replace-me
FLUXER_CLIENT_ID=replace-me
FLUXER_CLIENT_SECRET=replace-me

# Private HTTP base URL; a Jellyfin base path is supported.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_USER_ID=00000000000000000000000000000000
# User access token from a dedicated non-admin account, NOT an administrator API key.
JELLYFIN_ACCESS_TOKEN=replace-me

VIDEO_BITRATE=6000000
EMPTY_CHANNEL_SECONDS=60
SESSION_SECONDS=28800
# Development only: localhost UI HTTP and private HTTP Fluxer discovery.
ALLOW_INSECURE_LOCAL=false
# Exact reverse proxy IPs/CIDRs; empty ignores all X-Forwarded-For headers.
# Keep Uvicorn --no-proxy-headers so this trust policy is applied by the app.
TRUSTED_PROXY_CIDRS=
